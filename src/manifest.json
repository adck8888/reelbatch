{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Reelbatch",
  "description": "__MSG_extDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Reelbatch", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "downloads", "alarms", "notifications", "scripting", "debugger", "offscreen"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.replicate.com/*",
    "https://replicate.delivery/*",
    "https://api.lemonsqueezy.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["https://docs.google.com/*", "https://*.googleusercontent.com/*", "https://storage.googleapis.com/*"],
  "content_scripts": [
    { "matches": ["https://flow.google.com/*"], "js": ["flow-page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://flow.google.com/*"], "js": ["flow-content.js"], "run_at": "document_idle" }
  ]
}
